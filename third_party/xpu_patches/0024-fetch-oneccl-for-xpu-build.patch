diff --git a/cmake/XCCL.cmake b/cmake/XCCL.cmake
index 2fe9efd1..0e0c273e 100644
--- a/cmake/XCCL.cmake
+++ b/cmake/XCCL.cmake
@@ -11,0 +12,7 @@ if(NOT __XCCL_INCLUDED)
+  if(XCCL_FETCHED)
+    unset(XCCL_INCLUDE_DIR CACHE)
+    unset(XCCL_INCLUDE_ONEAPI_DIR CACHE)
+    unset(XCCL_LIBRARY_DIR CACHE)
+    unset(XCCL_LIBRARY CACHE)
+  endif()
+
@@ -13 +20 @@ if(NOT __XCCL_INCLUDED)
-  find_package(XCCL REQUIRED)
+  find_package(XCCL QUIET)
@@ -15,3 +22,86 @@ if(NOT __XCCL_INCLUDED)
-    set(PYTORCH_FOUND_XCCL FALSE)
-    message(WARNING "${XCCL_NOT_FOUND_MESSAGE}")
-    return()
+    include(ExternalProject)
+    include(FetchContent)
+
+    set(XCCL_FETCH_VERSION "2022.1.0")
+    set(XCCL_FETCH_GIT_TAG "d67031d54a29eb45892c8bdd279df82ae6df37cf")
+
+    message(STATUS
+      "System oneCCL was not found; fetching oneCCL ${XCCL_FETCH_VERSION}")
+    FetchContent_Declare(
+      oneccl
+      GIT_REPOSITORY https://github.com/uxlfoundation/oneCCL.git
+      GIT_TAG ${XCCL_FETCH_GIT_TAG}
+      GIT_SHALLOW FALSE
+      GIT_SUBMODULES_RECURSE TRUE)
+    if(POLICY CMP0169)
+      cmake_policy(PUSH)
+      cmake_policy(SET CMP0169 OLD)
+    endif()
+    FetchContent_GetProperties(oneccl)
+    if(NOT oneccl_POPULATED)
+      FetchContent_Populate(oneccl)
+    endif()
+    if(POLICY CMP0169)
+      cmake_policy(POP)
+    endif()
+
+    set(_oneccl_build_dir "${oneccl_BINARY_DIR}/build")
+    set(_oneccl_install_dir "${oneccl_BINARY_DIR}/install")
+    set(_oneccl_library "${_oneccl_install_dir}/lib/libccl.so.2.0")
+    cmake_path(GET SYCL_COMPILER PARENT_PATH _sycl_compiler_dir)
+    find_program(
+      _oneccl_cxx_compiler
+      NAMES icpx
+      HINTS "${_sycl_compiler_dir}"
+      NO_DEFAULT_PATH
+      REQUIRED)
+    set(_oneccl_build_jobs 16)
+    if(DEFINED ENV{MAX_JOBS} AND "$ENV{MAX_JOBS}" MATCHES "^[1-9][0-9]*$")
+      set(_oneccl_build_jobs "$ENV{MAX_JOBS}")
+    endif()
+
+    ExternalProject_Add(
+      oneccl_external
+      SOURCE_DIR "${oneccl_SOURCE_DIR}"
+      BINARY_DIR "${_oneccl_build_dir}"
+      INSTALL_DIR "${_oneccl_install_dir}"
+      PATCH_COMMAND
+        ${CMAKE_COMMAND}
+        "-DONECCL_SOURCE_DIR=<SOURCE_DIR>"
+        -P "${CMAKE_CURRENT_LIST_DIR}/patches/PatchOneCCL.cmake"
+      CMAKE_ARGS
+        "-DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}"
+        "-DCMAKE_C_COMPILER=${SYCL_COMPILER}"
+        "-DCMAKE_CXX_COMPILER=${_oneccl_cxx_compiler}"
+        "-DCMAKE_INSTALL_PREFIX=<INSTALL_DIR>"
+        "-DONECCL_BUILD_TESTS=OFF"
+        "-DONECCL_LIBCCL_BUILD_FT=OFF"
+        "-DONECCL_LIBCCL_BUILD_EXAMPLES=OFF"
+        "-DONECCL_LIBCCL_BUILD_REG_TESTS=OFF"
+        "-DONECCL_BUILD_CPU_PLUGIN=OFF"
+        "-DONECCL_ENABLE_ITT=OFF"
+        "-DCCL_ENABLE_ARCB=ON"
+      BUILD_COMMAND
+        ${CMAKE_COMMAND} --build <BINARY_DIR> --target ccl_legacy
+        --parallel ${_oneccl_build_jobs}
+      INSTALL_COMMAND
+        ${CMAKE_COMMAND} --build <BINARY_DIR> --target install
+        --parallel ${_oneccl_build_jobs}
+      BUILD_BYPRODUCTS "${_oneccl_library}"
+      LOG_OUTPUT_ON_FAILURE TRUE)
+
+    set(XCCL_INCLUDE_DIR
+        "${oneccl_SOURCE_DIR}/include"
+        "${oneccl_SOURCE_DIR}/deps/libccl/include")
+    set(XCCL_LIBRARY_DIR "${_oneccl_install_dir}/lib")
+    set(XCCL_LIBRARY "${_oneccl_library}")
+    set(XCCL_FETCHED TRUE CACHE INTERNAL
+        "Whether oneCCL is provided by the XPU build")
+
+    install(
+      DIRECTORY "${_oneccl_install_dir}/lib/"
+      DESTINATION "${TORCH_INSTALL_LIB_DIR}"
+      FILES_MATCHING PATTERN "*.so*")
+  else()
+    set(XCCL_FETCHED FALSE CACHE INTERNAL
+        "Whether oneCCL is provided by the XPU build")
@@ -21 +111,5 @@ if(NOT __XCCL_INCLUDED)
-  add_library(torch::xccl INTERFACE IMPORTED)
+  add_library(torch_xccl INTERFACE)
+  add_library(torch::xccl ALIAS torch_xccl)
+  if(TARGET oneccl_external)
+    add_dependencies(torch_xccl oneccl_external)
+  endif()
@@ -23 +117 @@ if(NOT __XCCL_INCLUDED)
-    TARGET torch::xccl PROPERTY INTERFACE_INCLUDE_DIRECTORIES
+    TARGET torch_xccl PROPERTY INTERFACE_INCLUDE_DIRECTORIES
@@ -28 +122 @@ if(NOT __XCCL_INCLUDED)
-    TARGET torch::xccl PROPERTY INTERFACE_LINK_LIBRARIES
+    TARGET torch_xccl PROPERTY INTERFACE_LINK_LIBRARIES
