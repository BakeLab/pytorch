diff --git a/cmake/ONEMKL.cmake b/cmake/ONEMKL.cmake
--- a/cmake/ONEMKL.cmake
+++ b/cmake/ONEMKL.cmake
@@ -28,7 +28,19 @@ set(TORCH_XPU_OPS_ONEMKL_INCLUDE_DIR ${ONEMKL_INCLUDE_DIR})
 set(TORCH_XPU_OPS_ONEMKL_LIBRARIES ${ONEMKL_LIBRARIES})

 # --start-group/--end-group are GNU ld options; MSVC link does not know them.
 if(NOT WIN32)
-  list(PREPEND TORCH_XPU_OPS_ONEMKL_LIBRARIES "-Wl,--start-group")
-  list(APPEND TORCH_XPU_OPS_ONEMKL_LIBRARIES "-Wl,--end-group")
+  list(SUBLIST ONEMKL_LIBRARIES 0 3 TORCH_XPU_OPS_ONEMKL_COMPONENT_LIBRARIES)
+  list(SUBLIST ONEMKL_LIBRARIES 3 -1 TORCH_XPU_OPS_ONEMKL_RUNTIME_LIBRARIES)
+
+  if(NOT CMAKE_CXX_LINK_LIBRARY_USING_MKL_NEEDED_SUPPORTED)
+    set(CMAKE_CXX_LINK_LIBRARY_USING_MKL_NEEDED
+        "LINKER:--push-state,--no-as-needed" "<LINK_ITEM>" "LINKER:--pop-state")
+    set(CMAKE_CXX_LINK_LIBRARY_USING_MKL_NEEDED_SUPPORTED TRUE)
+  endif()
+
+  if(CMAKE_CXX_LINK_LIBRARY_USING_MKL_NEEDED_SUPPORTED)
+    set(TORCH_XPU_OPS_ONEMKL_LIBRARIES
+        ${TORCH_XPU_OPS_ONEMKL_COMPONENT_LIBRARIES}
+        "$<LINK_LIBRARY:MKL_NEEDED,${TORCH_XPU_OPS_ONEMKL_RUNTIME_LIBRARIES}>")
+  endif()
 endif()
