+#if defined(NCCL_OS_LINUX) && CUDA_VERSION >= 11070
+class ncclGdrContextGuard {
+ public:
+  int activate(CUdevice dev) {
+    CUresult status = CUPFN(cuCtxGetCurrent(&previous_));
+    if (status != CUDA_SUCCESS) return ncclGdrCudaError(status, "cuCtxGetCurrent");
+    if (previous_ != nullptr) return 0;
+
+    device_ = dev;
+    status = CUPFN(cuDevicePrimaryCtxRetain(&current_, device_));
+    if (status != CUDA_SUCCESS) return ncclGdrCudaError(status, "cuDevicePrimaryCtxRetain");
+    retained_ = true;
+
+    status = CUPFN(cuCtxSetCurrent(current_));
+    if (status != CUDA_SUCCESS) return ncclGdrCudaError(status, "cuCtxSetCurrent");
+    switched_ = true;
+    return 0;
+  }
+
+  ~ncclGdrContextGuard() {
+    if (switched_) {
+      CUresult status = CUPFN(cuCtxSetCurrent(previous_));
+      if (status != CUDA_SUCCESS) (void)ncclGdrCudaError(status, "cuCtxSetCurrent(previous)");
+    }
+    if (retained_) {
+      CUresult status = CUPFN(cuDevicePrimaryCtxRelease(device_));
+      if (status != CUDA_SUCCESS) (void)ncclGdrCudaError(status, "cuDevicePrimaryCtxRelease");
+    }
+  }
+
+ private:
+  CUdevice device_{};
+  CUcontext current_ = nullptr;
+  CUcontext previous_ = nullptr;
+  bool retained_ = false;
+  bool switched_ = false;
+};
+
+class ncclGdrFd {
+ public:
+  int* data() {
+    return &fd_;
+  }
+
+  int get() const {
+    return fd_;
+  }
+
+  int release() {
+    int fd = fd_;
+    fd_ = -1;
+    return fd;
+  }
+
+  ~ncclGdrFd() {
+    if (fd_ >= 0) (void)close(fd_);
+  }
+
+ private:
+  int fd_ = -1;
+};
+#endif
